{
  "name": "ratlevel",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @ratlevel/mobile",
    "portal": "npm run dev --workspace @ratlevel/gym-portal",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "expo-font": "~14.0.12"
  }
}
